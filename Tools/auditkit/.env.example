# Block explorer API key used by `auditkit recon` to pull verified source.
# Get one free at https://etherscan.io/apis (works across the multichain v2 API).
ETHERSCAN_API_KEY=

# RPC endpoint used for `anvil --fork-url` when generating/running exploit PoCs.
# Point this at a provider (Alchemy/Infura/local node). Forking is READ-ONLY
# against a local Anvil copy of chain state -- no live funds are ever touched.
FORK_RPC_URL=

# Optional: pin exploit PoC forks to a specific block for reproducibility.
FORK_BLOCK_NUMBER=
